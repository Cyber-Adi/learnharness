{
	"all": true,
	"include": ["components/mobile/**", "src/server/remote/**"],
	"exclude": ["tests/**", "e2e/**", "**/*.test.*"],
	"extension": [".ts", ".tsx"],
	"reporter": ["text-summary", "lcov"],
	"reports-dir": "coverage",
	"check-coverage": true,
	"lines": 80,
	"functions": 80,
	"branches": 80,
	"statements": 80
}
