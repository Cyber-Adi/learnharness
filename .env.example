# Copy to .env.local. Never commit real values.

# Where LearnHarness keeps its data (optional; defaults to the app data dir).
# LH_DATA_DIR=/absolute/path/to/data

# Remote access is OFF unless this is set. Comma-separated lowercase hostnames,
# optional :port. No schemes, paths, wildcards, IP addresses, or localhost.
# LH_REMOTE_HOSTS=my-mac.tailnet-1234.ts.net

# Set to 1 to render the mobile shell on this build.
NEXT_PUBLIC_LH_MOBILE_SHELL=0

# LH_DESKTOP_API_SECRET is generated by Electron on every launch and passed in
# the process environment. It never goes in a file.
